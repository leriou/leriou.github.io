---
/**
 * Waline 评论组件
 * - 客户端走 npm 依赖本地打包(不依赖 CDN,国内访问稳定)
 * - 自动跟随站点暗色模式(html.dark)
 * - 兼容 Fuwari 的 swup 页面切换:每次 page:view 重新挂载
 * - serverURL 未配置时整体不渲染(见 src/config.ts commentConfig)
 */
import walineCss from "@waline/client/waline.css?url";
import { commentConfig } from "src/config";

const enabled = commentConfig.enable && !!commentConfig.serverURL;
---

{
	enabled && (
		<>
		<link rel="stylesheet" href={walineCss} />
		<div class="card-base w-full rounded-[var(--radius-large)] px-6 md:px-9 pt-6 pb-6 mb-4 onload-animation">
			<h2 class="text-lg font-bold text-black/90 dark:text-white/90 mb-4 transition flex flex-row items-center gap-2 before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]">
				评论
			</h2>
			<div id="waline" data-server={commentConfig.serverURL} />
		</div>
		</>
	)
}

{
	enabled && (
		<script>
			import { init } from "@waline/client";

			type WalineInstance = { destroy: () => void };
			const walineInitOptions = {
				lang: "zh-CN" as const,
				dark: "html.dark",
				pageview: true,
				search: false,
				copyright: false,
			};
			let instance: WalineInstance | null = null;

			function mountComments() {
				const el = document.getElementById("waline");
				if (!el) return;
				if (instance) {
					instance.destroy();
					instance = null;
				}
				const serverURL = el.dataset.server;
				if (!serverURL) return;
				instance = init({
					el,
					serverURL,
					...walineInitOptions,
				}) as unknown as WalineInstance;
			}

			// 首次加载
			mountComments();

			// swup 页面切换后重新挂载(swup 初始化可能稍晚于本脚本,轮询等待)
			function hookSwup() {
				const swup = (window as unknown as { swup?: { hooks: { on: (event: string, fn: () => void) => void } } }).swup;
				if (swup?.hooks) {
					swup.hooks.on("page:view", mountComments);
				} else {
					setTimeout(hookSwup, 100);
				}
			}
			hookSwup();
		</script>
	)
}
